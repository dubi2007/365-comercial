  "consultas": [
    {
      "titulo": "Listado completo de clientes",
      "descripcion": "Obtiene todos los clientes registrados en el sistema",
      "sql": "SELECT * FROM CLIENTES;",
      "resultadoEsperado": "5 clientes: Panadería El Trigo, Gimnasio FitLife, Veterinaria Huellas, Café Aroma, Consultora Andes"
    },
    {
      "titulo": "Campañas activas en 2025",
      "descripcion": "Lista las campañas que iniciaron en el año 2025",
      "sql": "SELECT nombre, fecha_inicio FROM CAMPANAS WHERE EXTRACT(YEAR FROM fecha_inicio) = 2025;",
      "resultadoEsperado": "5 campañas activas con fechas entre enero y mayo de 2025"
    },
    {
      "titulo": "Personal con rol específico",
      "descripcion": "Encuentra empleados con rol de Community Manager",
      "sql": "SELECT nombre FROM EMPLEADOS WHERE rol = 'Community Manager';",
      "resultadoEsperado": "María González (Community Manager)"
    },
    {
      "titulo": "Facturas de alto valor",
      "descripcion": "Facturas con monto superior a $1000",
      "sql": "SELECT factura_id, total FROM FACTURAS WHERE total > 1000;",
      "resultadoEsperado": "5 facturas con montos entre $1,300 y $2,100"
    },
    {
      "titulo": "Leads en estado pendiente",
      "descripcion": "Prospectos que requieren seguimiento",
      "sql": "SELECT * FROM LEADS WHERE estado = 'Pendiente';",
      "resultadoEsperado": "2 leads pendientes: Roberto Silva y Sofia Vega"
    },
    {
      "titulo": "Contratos activos por ciudad",
      "descripcion": "Contratos vigentes filtrados por ubicación del cliente",
      "sql": "SELECT c.nombre, co.estado FROM CONTRATOS co JOIN CLIENTES c ON co.cliente_id = c.cliente_id WHERE co.estado = 'Activo' AND c.ciudad = 'Lima';",
      "resultadoEsperado": "2 contratos activos en Lima: Panadería El Trigo y Veterinaria Huellas"
    },
    {
      "titulo": "Total de pagos por cliente",
      "descripcion": "Suma de todos los pagos realizados por cada cliente",
      "sql": "SELECT c.nombre, SUM(p.monto) AS total_pagado FROM PAGOS p JOIN FACTURAS f ON p.factura_id = f.factura_id JOIN CLIENTES c ON f.cliente_id = c.cliente_id GROUP BY c.nombre;",
      "resultadoEsperado": "4 clientes con pagos totales entre $1,300 y $2,100"
    },
    {
      "titulo": "Publicaciones por plataforma",
      "descripcion": "Content publicado en redes sociales específicas",
      "sql": "SELECT p.titulo, c.nombre FROM PUBLICACIONES p JOIN CAMPANAS c ON p.campana_id = c.campana_id JOIN REDES_SOCIALES r ON p.red_id = r.red_id WHERE r.nombre = 'Facebook';",
      "resultadoEsperado": "2 publicaciones en Facebook: Promoción Pan Integral y Cuidado de Mascotas"
    },
    {
      "titulo": "Servicios premium",
      "descripcion": "Servicios con precio superior al promedio",
      "sql": "SELECT nombre, precio FROM SERVICIOS WHERE precio > (SELECT AVG(precio) FROM SERVICIOS);",
      "resultadoEsperado": "2 servicios premium: Google Ads ($1,200) y Facebook Ads ($1,000)"
    },
    {
      "titulo": "Resumen de campañas por cliente",
      "descripcion": "Contador de campañas ejecutadas por cada cliente",
      "sql": "SELECT c.nombre, COUNT(*) AS total_campanas FROM CLIENTES c JOIN CAMPANAS ca ON c.cliente_id = ca.cliente_id GROUP BY c.nombre;",
      "resultadoEsperado": "5 clientes con 1 campaña cada uno, total: 5 campañas"
    }
  ],
